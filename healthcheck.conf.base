# healthcheck.conf.base — shipped defaults for Linux Health Check
# ==============================================================
# DO NOT EDIT. Every upgrade overwrites this file.
#
# This is the base layer the application reads on every run. Your
# own settings go in healthcheck.conf beside it, which holds ONLY
# what you want to be different — anything you put there wins over
# the value here, and anything you leave out is taken from here.
#
# That is what lets an upgrade deliver a new setting: it appears
# in this file with a working default and your healthcheck.conf is
# never touched.
#
#   healthcheck.py config show     what this host is actually using,
#                                  and which layer each value came from
#   healthcheck.py config set smtp.host=relay.example.com
#                                  write one override into healthcheck.conf
# ==============================================================

[general]
# The name this host calls itself in the report header, the email subject and
# the saved report filenames.
#
# Leave it blank and the kernel hostname is used (`hostname` on the command
# line). The script deliberately does NOT trust socket.getfqdn(): that
# reverse-resolves the machine's name and returns the FIRST answer, which on a
# clustered host is routinely a shared VIP. Three RKE2 nodes behind
# xlp-mgmt.example.com each called themselves xlp-mgmt, so their reports
# were indistinguishable and three machines' alerts looked like one host
# flapping. Nor is that answer stable — it moves with the VIP, with DNS and with
# cache state, and an identity that drifts is worse than a wrong one.
#
# Set it only if you want something other than the kernel hostname — a fully
# qualified name, say, or a role label.
hostname =


[smtp]
# SMTP relay host.
# Leave blank to use localhost (Postfix must be running and able to relay).
# MPT default: relay.domain.com on port 25, no authentication required.
host = relay.domain.com
port = 25

# Set to true if your relay requires TLS (SMTPS on port 465)
use_tls = false

# Leave blank if your relay does not require authentication
username =
password =

# The From: address that will appear in all emails sent by this script.
# Leave it commented out to use healthcheck@<this host's FQDN>, which is right
# on almost every host. Uncomment only when the relay demands a fixed sender.
#from = healthcheck@domain.com


[email]
# ─────────────────────────────────────────────────────────────
# Two lists, two different purposes. Getting this backwards is
# what causes alert fatigue, so read this before editing.
# ─────────────────────────────────────────────────────────────

# THE SELECTED GROUP — the small team that wants to know the check
# itself is alive. They receive a message on EVERY run, even when
# everything is fine ("[daily] ... all clear"). This is the
# "the monitoring is working" signal. Keep this list short.
#
# Comma separated; a long list may be wrapped onto indented lines:
#   daily_recipients = ops.a@domain.com,
#                      ops.b@domain.com
# Empty here on purpose — set it in healthcheck.conf.
daily_recipients =

# EVERYONE — the broad audience. They are only written to when the
# run finds something NEW or something that got WORSE (subject is
# tagged "[ACTION]"). A condition that has already been reported
# does not notify this list again until it clears, gets worse, or
# hits the reminder interval below.
#
# This is the whole point: if a message reaches this list, it is
# because something actually changed.
#
# Empty here on purpose — set it in healthcheck.conf. With no list
# configured the run degrades to a heartbeat and says so.
alert_recipients =

# How the HTML report reaches the reader:
#   inline     — rendered in the message body (recommended; people read it)
#   attachment — plain text in the body, HTML as a downloadable file
#   both       — rendered inline AND attached, for archiving
html_mode = inline


[alerts]
# Minimum severity that notifies alert_recipients: caution | unhealthy
notify_all_on = unhealthy

# A condition that is still open gets ONE reminder every N hours.
# Set to 0 to notify once only, on first sight.
# Defaults: a week for CAUTION, a day for UNHEALTHY.
remind_caution_hours = 168
remind_unhealthy_hours = 24

# Once a condition has been clear for this many hours it is forgotten,
# so that a genuine recurrence counts as new and notifies again.
forget_after_hours = 72


[checks]
# Listening-port inventory.
# Loopback sockets (127.x, ::1) cannot be reached from off the host, and
# applications churn through random high ports on 127.0.0.1 all day, which is
# pure noise in a daily report. By default only sockets reachable from the
# network are listed and diffed. Set true to list the loopback ones too.
# Whatever is listed is listed in full — the inventory is never truncated.
list_local_ports = false

# Extra path patterns to skip in the /etc modification scan (comma separated
# shell globs). Backup agents that write timestamped files into /etc belong
# here — CommVault drops a new .zst into its registry backup directory every
# 90 minutes, and each one looked like a fresh configuration change.
etc_ignore = /etc/CommVaultRegistryBackups/*

# Extra mount points to skip in the disk check (comma separated globs), ON TOP
# OF a built-in list that already covers kubelet, containerd, docker and snap.
# Those built-ins exist because Kubernetes bind-mounts a pod's subPaths and its
# local-path PVCs off the root filesystem: df reports each one with the ROOT
# device's own numbers, so a node running forty such pods printed forty
# identical rows — and forty identical alerts the moment / crossed 90%.
# Add a path here only if some other tool mounts noise this list misses.
disk_ignore =

# Explicit kubeconfig for the Kubernetes section. Leave blank to auto-discover
# $KUBECONFIG, /etc/rancher/rke2/rke2.yaml, /etc/rancher/k3s/k3s.yaml,
# /etc/kubernetes/admin.conf and ~/.kube/config.
kubeconfig =


[kubernetes]
# This whole section appears only on a host that has BOTH kubectl and a
# readable kubeconfig. A kubectl that cannot reach a cluster says nothing worth
# printing, so nothing is printed.
#
# Note the section finds kubectl by absolute path as well as by $PATH. The
# cron entry runs with PATH=/usr/bin:/bin and no login profile, so the
# `export PATH=/var/lib/rancher/rke2/bin:$PATH` that makes kubectl work in your
# shell does not exist during the nightly run.

# auto    — the whole cluster, plus a per-node pod summary when the cluster has
#           more than one node (so each node's report leads with its own pods)
# cluster — always the whole cluster
# node    — only the pods scheduled on this host
# off     — no Kubernetes section at all
scope = auto

# Individual signals, so one noisy source can be silenced without losing the
# rest of the section.
nodes  = true
pods   = true
pvcs   = true
events = true
images = true

# Container images churn on every deploy, so the default is a count only.
# Set true to also list the largest ones.
list_images = false


[thresholds]
# CPU usage per core — percentage that triggers each level
cpu_caution   = 80
cpu_unhealthy = 95

# Disk usage per mount point — percentage that triggers each level
disk_caution   = 90
disk_unhealthy = 95

# RAM usage — percentage that triggers each level
ram_caution   = 80
ram_unhealthy = 95

# Load average thresholds as a multiplier of the CPU core count.
# Example on a 4-core machine:
#   caution   = 1.0 × 4 = 4.00  (load avg ≥ 4.00 → CAUTION)
#   unhealthy = 2.0 × 4 = 8.00  (load avg ≥ 8.00 → UNHEALTHY)
load_caution_mult   = 1.0
load_unhealthy_mult = 2.0

# Zombie processes. A few are routine and clear on their own.
zombie_caution   = 10
zombie_unhealthy = 50

# Failed SSH attempts TODAY. Any host reachable from the internet sees a
# constant background level of these, so the defaults are deliberately high.
failed_ssh_caution   = 50
failed_ssh_unhealthy = 500

# Pending updates are planned maintenance, not an incident, so by default
# they are reported as INFO and never notify anyone. Set a number here to
# raise CAUTION once the backlog passes it (e.g. 100), or leave 0 to disable.
updates_caution          = 0
security_updates_caution = 0

# fail2ban bans mean fail2ban is WORKING, so they are informational.
# Set a number to flag an unusual spike (e.g. 50), or leave 0 to disable.
banned_ips_caution = 0

# Docker: a container that exited non-zero within this many hours is treated
# as a fresh crash (CAUTION). Anything stopped longer ago is assumed to have
# been stopped deliberately and is reported as INFO.
docker_recent_hours = 24

# Kubernetes: a pod Pending or ContainerCreating for less than this is the
# scheduler doing its job. Past it, something is actually stuck.
k8s_pending_minutes = 15

# A pod's restart COUNT is meaningless — 200 days up with 5 restarts is a
# healthy pod. What matters is how many it picked up SINCE THE LAST RUN.
k8s_restart_delta_caution = 3

# Evicted pod objects persist until they are garbage collected, so an eviction
# from last month is not today's news. Only recent ones raise CAUTION.
k8s_evicted_recent_hours = 24

# Guard rail: stop reading the pod list past this many rows.
k8s_max_pods = 2000


[crontab]
# Default run time used when you call: python3 healthcheck.py crontab
# You can override it by passing the time as argument: crontab 06:30
time = 00:07

# Spread the run out instead of starting it exactly on the hour.
#
# Every host installs the same cron time, so at 07:00 a whole fleet starts
# reading /proc, walking /etc and shelling out to df, dnf and kubectl at once —
# on servers that are frequently still inside their backup window. The check
# then reports the CPU spike it caused itself, and that alert goes to people
# for whom 07:00 CPU is entirely expected.
#
# With this on, cron still fires at `time` above and the run then waits a
# random slice of `random_window` before touching anything, re-drawn every
# night. `crontab -l` keeps showing one fixed, readable time, and the chosen
# delay is written to /var/log/healthcheck.log the moment the job starts, so a
# waiting host is never mistaken for a hung one.
#
# Only the cron run waits. `healthcheck.py run` typed by hand starts at once.
random = true

# How long after `time` the run may start: 4h, 90m, 2h30m — or a bare number,
# read as hours. With time = 07:00 and 4h, the checks begin somewhere in
# 07:00–11:00. Set random = false above to always start on the hour.
#
# Keep `time` + this window inside one calendar day. The log checks (failed
# SSH, kernel errors, service failures) only count TODAY's entries, so a run
# that is pushed past midnight reports on a day that is minutes old and finds
# almost nothing. time = 23:00 with a 4h window is the way to get a silent,
# useless report — not a late one.
random_window = 8h

# Interpreter the cron entry runs under. Leave blank to use whichever python
# ran `healthcheck.py crontab` (correct for miniconda / /opt standalone builds
# on hosts where /usr/bin/python3 is missing or too old).
# Env var HEALTHCHECK_PYTHON overrides this.
python =
